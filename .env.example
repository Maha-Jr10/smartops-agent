# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
APP_ENV=local
LOG_LEVEL=INFO
# Plafond quotidien d'appels LLM pour la démo publique
DAILY_LLM_CALL_CAP=500
RATE_LIMIT_PER_MINUTE=10

# Cloud: configure these as Railway variables, not in Git.
# MLFLOW_TRACKING_URI=https://dagshub.com/Maha-Jr10/smartops-agent.mlflow
# MLFLOW_TRACKING_USERNAME=Maha-Jr10
# MLFLOW_TRACKING_PASSWORD=<DagsHub access token>
# GRAFANA_PROM_URL=<Grafana Cloud Prometheus remote-write URL>
# GRAFANA_PROM_USERNAME=<Grafana Cloud Prometheus username>
# GRAFANA_PROM_PASSWORD=<Grafana Cloud access policy token with metrics:write>
